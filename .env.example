# Vive Code - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Application
NODE_ENV=development
PORT=3000
API_PORT=5000
APP_NAME=Vive Code
APP_URL=http://localhost:3000
API_URL=http://localhost:5000

# Database
DATABASE_URL=postgresql://localhost:5432/vivecode
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this
SESSION_SECRET=your-session-secret-change-this

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Netlify Deployment
NETLIFY_CLIENT_ID=your-netlify-client-id
NETLIFY_CLIENT_SECRET=your-netlify-client-secret

# AI Providers
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
PERPLEXITY_API_KEY=your-perplexity-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
EDEN_AI_API_KEY=your-eden-ai-api-key
LONGCAT_AI_API_KEY=your-longcat-ai-api-key

# AI Configuration
AI_PROMPT_LIMIT_PER_WEEK=1000
AI_DEFAULT_PROVIDER=openai

# File Storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=vivecode-projects

# Docker & Sandbox
DOCKER_HOST=unix:///var/run/docker.sock
SANDBOX_TIMEOUT=300
MAX_CONCURRENT_SANDBOXES=10

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000

# WebSocket
WS_PORT=8080

# Feature Flags
FEATURE_COLLABORATION=true
FEATURE_AI_ASSISTANCE=true
FEATURE_EDUCATION_MODE=true
FEATURE_MARKETPLACE=true
